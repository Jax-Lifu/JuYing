{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juying.local/schemas/sources.schema.json",
  "title": "JuYing source configuration",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "adapter", "entryUrl", "enabled", "authorization", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "name": { "type": "object", "additionalProperties": { "type": "string" } },
          "kind": { "enum": ["officialWeb", "authorizedApi", "nas", "local", "custom"] },
          "adapter": { "type": "string", "enum": ["cctvOfficial", "cctvLiveOfficial", "playlistConfig", "tvboxConfig"] },
          "configVersion": { "type": "integer", "minimum": 1 },
          "priority": { "type": "integer", "minimum": -100, "maximum": 100 },
          "entryUrl": { "type": "string" },
          "enabled": { "type": "boolean" },
          "authorization": { "enum": ["officialEntryOnly", "userOwned", "licensed", "unknown"] },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "credentialsRef": { "type": "string", "pattern": "^secure://" },
          "regionCode": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

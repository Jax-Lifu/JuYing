<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_enabled="false"><shape><solid android:color="?attr/jy_surface"/><corners android:radius="@dimen/jy_radius"/></shape></item>
 <item android:state_focused="true"><shape><solid android:color="?attr/jy_surface_variant"/><stroke android:width="2dp" android:color="?attr/jy_accent"/><corners android:radius="@dimen/jy_radius"/></shape></item>
 <item android:state_pressed="true"><shape><solid android:color="?attr/jy_surface_variant"/><stroke android:width="1dp" android:color="?attr/jy_accent"/><corners android:radius="@dimen/jy_radius"/></shape></item>
 <item><shape><solid android:color="?attr/jy_surface"/><stroke android:width="1dp" android:color="?attr/jy_on_surface_secondary"/><corners android:radius="@dimen/jy_radius"/></shape></item>
</selector>

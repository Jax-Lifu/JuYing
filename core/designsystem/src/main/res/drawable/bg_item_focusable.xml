<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/jy_surface_variant" />
            <stroke android:width="3dp" android:color="?attr/jy_accent" />
            <corners android:radius="@dimen/jy_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/jy_surface_variant" />
            <corners android:radius="@dimen/jy_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/jy_surface" />
            <corners android:radius="@dimen/jy_radius" />
        </shape>
    </item>
</selector>

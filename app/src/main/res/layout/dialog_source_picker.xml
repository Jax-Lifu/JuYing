<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/jy_padding" android:background="?attr/jy_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView style="@style/JyTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_switch_source"/>
        <ImageButton android:id="@+id/close" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_item_focusable" android:src="@drawable/ic_close" android:contentDescription="@string/ui_close"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/all" style="@style/JyAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_sources"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/recent" style="@style/JyAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ui_recent"/>
    </LinearLayout>
    <EditText android:imeOptions="flagNoFullscreen" android:id="@+id/query" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="text" android:hint="@string/ui_source_search"/>
    <TextView android:id="@+id/empty" style="@style/JyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/source_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/manage" style="@style/JyAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_manage"/>
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/jy_padding" android:background="?attr/jy_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" >
<androidx.appcompat.widget.AppCompatButton android:id="@+id/back" android:drawableStart="@drawable/ic_back" style="@style/JyAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/content_back" />
<TextView style="@style/JyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/jy_padding" android:text="@string/search_title"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="@dimen/jy_padding">
<EditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/jy_touch_height" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch|flagNoFullscreen" android:hint="@string/search_hint" android:textColor="?attr/jy_on_surface" android:textColorHint="?attr/jy_on_surface_secondary"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/submit" android:drawableStart="@drawable/ic_search" style="@style/JyAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/content_search" />
</LinearLayout>
<TextView android:id="@+id/catalogNote" style="@style/JyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_catalog_note"/>
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"/>
<TextView android:id="@+id/status" style="@style/JyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/jy_content_gap" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/failures" style="@style/JyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/posters" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" >
<androidx.appcompat.widget.AppCompatButton android:id="@+id/retry" android:drawableStart="@drawable/ic_search" style="@style/JyAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/content_retry" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/more" android:drawableStart="@drawable/ic_expand" style="@style/JyAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/content_more" android:layout_marginStart="@dimen/jy_content_gap"/>
</LinearLayout>
</LinearLayout>

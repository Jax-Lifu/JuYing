<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_item_focusable"
    android:focusable="true"
    android:minHeight="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/logo"
        android:theme="@style/Theme.Juying.Light"
        android:layout_width="80dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_channel_logo"
        android:padding="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/jy_on_surface"
        android:textSize="@dimen/jy_text_body" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_play"
        android:tint="?attr/jy_on_surface_secondary"
        android:importantForAccessibility="no" />
</LinearLayout>
